# PairPlay Server Environment Variables

# Node Environment
NODE_ENV=development
PORT=4000

# Database Connection (PostgreSQL for production, or SQLite file:./dev.db for local dev)
DATABASE_URL="postgresql://postgres:password@localhost:5432/pairplay?schema=public"

# Authentication Security
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:3000

# AI Provider API Keys (Optional - falls back seamlessly to 28+ curated database questions)
GEMINI_API_KEY=your_gemini_api_key_here
