// Prisma schema for PairPlay
// Premium full-stack couples website

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  bio          String?
  partnerCode  String   @unique
  interests    String   @default("[]") // JSON stringified array of interest tags
  loveLanguage String?  @default("Quality Time")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  hostedRooms    Room[]        @relation("RoomHost")
  partnerRooms   Room[]        @relation("RoomPartner")
  answers        GameAnswer[]
  events         ProductEvent[]
  couplesAsUser1 Couple[]      @relation("CoupleUser1")
  couplesAsUser2 Couple[]      @relation("CoupleUser2")

  @@index([email])
  @@index([partnerCode])
}

model Couple {
  id           String   @id @default(uuid())
  user1Id      String
  user2Id      String
  status       String   @default("ACTIVE") // ACTIVE, DISCONNECTED
  anniversary  DateTime?
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user1        User     @relation("CoupleUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2        User     @relation("CoupleUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  dailySparks  DailySpark[]

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

model Room {
  id           String        @id @default(uuid())
  code         String        @unique // 6-character room code, e.g. "PP8492"
  hostId       String
  partnerId    String?
  status       String        @default("WAITING") // WAITING, IN_GAME, FINISHED, ABANDONED
  category     String        @default("Deep Connections")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  host         User          @relation("RoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  partner      User?         @relation("RoomPartner", fields: [partnerId], references: [id], onDelete: SetNull)
  gameSessions GameSession[]

  @@index([code])
  @@index([hostId])
  @@index([partnerId])
}

model GameSession {
  id                   String         @id @default(uuid())
  roomId               String
  category             String
  status               String         @default("PREPARING") // PREPARING, IN_PROGRESS, REVEALING, COMPLETED, CANCELLED
  currentQuestionIndex Int            @default(0)
  totalQuestions       Int            @default(5)
  startedAt            DateTime       @default(now())
  completedAt          DateTime?

  room                 Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  questions            GameQuestion[]
  answers              GameAnswer[]

  @@index([roomId])
  @@index([status])
}

model Question {
  id             String   @id @default(uuid())
  text           String
  category       String
  isAiGenerated  Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([category])
}

model GameQuestion {
  id            String       @id @default(uuid())
  gameSessionId String
  questionText  String
  category      String
  orderIndex    Int

  gameSession   GameSession  @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  answers       GameAnswer[]

  @@index([gameSessionId])
}

model GameAnswer {
  id            String       @id @default(uuid())
  gameSessionId String
  gameQuestionId String
  userId        String
  answerText    String
  reaction      String?      // e.g. "❤️", "😂", "✨", "🤔"
  submittedAt   DateTime     @default(now())

  gameSession   GameSession  @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  gameQuestion  GameQuestion @relation(fields: [gameQuestionId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Enforces authoritative single answer per user per question in session
  @@unique([gameSessionId, gameQuestionId, userId])
  @@index([gameSessionId])
  @@index([userId])
}

model DailySpark {
  id            String    @id @default(uuid())
  coupleId      String?
  date          String    // YYYY-MM-DD format
  questionText  String
  category      String
  isAiGenerated Boolean   @default(false)
  createdAt     DateTime  @default(now())

  couple        Couple?   @relation(fields: [coupleId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([coupleId])
}

model ProductEvent {
  id        String   @id @default(uuid())
  userId    String?
  eventType String   // e.g., 'signup_completed', 'room_created', 'invitation_accepted', 'game_started', 'game_completed', 'question_answered', 'ai_generation_succeeded', 'ai_generation_failed', 'reconnect_succeeded'
  metadata  String   @default("{}") // JSON string of event metadata (privacy-safe, NO private answers)
  timestamp DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType])
  @@index([timestamp])
  @@index([userId])
}
